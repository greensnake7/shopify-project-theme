
.splide:hover .splide__arrow--next {
  --tw-translate-x : -0.5rem;
  transform:translate(var(--tw-translate-x), var(--tw-translate-y)) rotate(var(--tw-rotate)) skewX(var(--tw-skew-x)) skewY(var(--tw-skew-y)) scaleX(var(--tw-scale-x)) scaleY(var(--tw-scale-y))
}
.splide:hover .splide__arrow--next:disabled, 
.splide:hover .splide__arrow--prev:disabled {
  opacity:0.3
}
.splide:hover .splide__arrow--prev {
  --tw-translate-x : 0.5rem;
  transform:translate(var(--tw-translate-x), var(--tw-translate-y)) rotate(var(--tw-rotate)) skewX(var(--tw-skew-x)) skewY(var(--tw-skew-y)) scaleX(var(--tw-scale-x)) scaleY(var(--tw-scale-y))
}

* {
  box-sizing: border-box;
}

*,
*::before,
*::after {
  border-color: var(--color-border);
}

body {
  display: flex;
  flex-direction: column;
  margin: 0;
  min-height: 100svh;
}

html:has(dialog[scroll-lock][open], details[scroll-lock][open]) {
  overflow: hidden;
}

img,
picture,
video,
canvas,
svg {
  display: block;
}

input,
textarea,
select {
  font: inherit;
  border-radius: var(--style-border-radius-inputs);
}

select {
  background-color: var(--color-background);
  color: currentcolor;
}

dialog {
  background-color: var(--color-background);
  color: var(--color-foreground);
}

p {
  text-wrap: pretty;
}
p,
h1,
h2,
h3,
h4,
h5,
h6 {
  overflow-wrap: break-word;
}

p:empty {
  display: none;
}

:is(p, h1, h2, h3, h4, h5, h6):first-child,
:empty:first-child + :where(p, h1, h2, h3, h4, h5, h6) {
  margin-block-start: 0;
}

:is(p, h1, h2, h3, h4, h5, h6):last-child,
:where(p, h1, h2, h3, h4, h5, h6) + :has(+ :empty:last-child) {
  margin-block-end: 0;
}

/** Theme styles below */
body{
  line-height:1.375;
  font-family: var(--font-body-family);
  font-style: var(--font-body-style);
  font-weight: var(--font-body-weight);
  letter-spacing: var(--body-letter-spacing);
  background: var(--color-background);
  color: var(--color-text)
}
.font-heading{
  font-family:var(--font-heading-family)
}

.page-width {
  max-width: calc(var(--page-width) + 40px);
  margin-right:auto;
  margin-left:auto;
  padding-right:1.25rem;
  padding-left:1.25rem;
}
.page-width-mobile{margin-right:auto;margin-left:auto;padding-right:1.25rem;padding-left:1.25rem}
.carousel-mobile.page-width-mobile{padding-left:0px;padding-right:0px}
.full-width{padding-left:1.25rem;padding-right:1.25rem}
/** Section layout utilities */

/**
 * Setup a grid that enables both full-width and constrained layouts
 * depending on the class of the child elements.
 *
 * By default, a minimum content margin is set on the left and right
 * sides of the section and the content is centered in the viewport to
 * not exceed the maximum page width.
 *
 * When a child element is given the `full-width` class, it will span
 * the entire viewport.
 */
.x-section {
  margin-top: var(--advanced-sections-spacing);
  margin-bottom: var(--advanced-sections-spacing);
}

h1, .h1, h2, .h2, h3, .h3, h4, .h4, h5, .h5, h6, .h6, .x-heading {
  text-transform: var(--heading-text-tranform);
  font-family: var(--font-heading-family);
  font-style: var(--font-heading-style);
  font-weight: var(--font-heading-weight);
  letter-spacing: var(--heading-letter-spacing);
  color: var(--color-heading);
  overflow-wrap:break-word
}
.menu.header_menu {
  text-transform: var(--menu-text-tranform);
  font-family: var(--font-menu);
  font-weight: var(--font-menu-weight);
  font-style: var(--font-menu-style);
  letter-spacing: var(--menu-letter-spacing);
  overflow-wrap: break-word
}
.highlight.hl-font {
  font-family: var(--font-heading-highlight);
  font-style: var(--font-heading-highlight-style);
  font-weight: var(--font-heading-highlight-weight);
  letter-spacing: var(--heading-highlight-letter-spacing);
  color: rgba(var(--color-highlight));
  font-size: var(--heading-highlight-font-size);
}
