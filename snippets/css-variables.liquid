{%- liquid
  case settings.buttons_type
    when 'rounded'
      assign border_radius = '100px'
    when 'rounded_corners'
      assign border_radius = '6px'
    else
      assign border_radius = '0'
  endcase
  case settings.edges_type
    when 'rounded_corners'
      assign edges_radius = '10px'
    else
      assign edges_radius = '0'
  endcase
  assign scheme = settings.color_scheme
  assign scheme_dark = settings.color_scheme_dark
%}
{%- render 'typography-sizes' -%}
{% style %}
  :root,
  *:before {
    --font-size-h1-desktop:calc(max(10, var(--text-size-h1-desktop)) * 1px);
    --font-size-h1-tablet:calc(max(10, var(--text-size-h1-tablet)) * 1px);
    --font-size-h1-mobile:calc(max(10, var(--text-size-h1-mobile)) * 1px);
    --font-size-h2-desktop:calc(max(10, var(--text-size-h2-desktop)) * 1px);
    --font-size-h2-tablet:calc(max(10, var(--text-size-h2-tablet)) * 1px);
    --font-size-h2-mobile:calc(max(10, var(--text-size-h2-mobile)) * 1px);
    --font-size-h3-desktop:calc(max(10, var(--text-size-h3-desktop)) * 1px);
    --font-size-h3-tablet:calc(max(10, var(--text-size-h3-tablet)) * 1px);
    --font-size-h3-mobile:calc(max(10, var(--text-size-h3-mobile)) * 1px);
    --font-size-h4-desktop:calc(max(10, var(--text-size-h4-desktop)) * 1px);
    --font-size-h4-tablet:calc(max(10, var(--text-size-h4-tablet)) * 1px);
    --font-size-h4-mobile:calc(max(10, var(--text-size-h4-mobile)) * 1px);
    --font-size-h5-desktop:calc(max(10, var(--text-size-h5-desktop)) * 1px);
    --font-size-h5-tablet:calc(max(10, var(--text-size-h5-tablet)) * 1px);
    --font-size-h5-mobile:calc(max(10, var(--text-size-h5-mobile)) * 1px);
    --font-size-h6-desktop:calc(max(10, var(--text-size-h6-desktop)) * 1px);
    --font-size-h6-tablet:calc(max(10, var(--text-size-h6-tablet)) * 1px);
    --font-size-h6-mobile:calc(max(10, var(--text-size-h6-mobile)) * 1px);
    --font-size-subheading-desktop:calc(max(10, var(--text-size-subheading-desktop)) * 1px);
    --font-size-subheading-tablet:calc(max(10, var(--text-size-subheading-tablet)) * 1px);
    --font-size-subheading-mobile:calc(max(10, var(--text-size-subheading-mobile)) * 1px);
    --font-size-p3-desktop:calc(max(10, var(--text-size-p3-desktop)) * 1px);
    --font-size-p3-tablet:calc(max(10, var(--text-size-p3-tablet)) * 1px);
    --font-size-p3-mobile:calc(max(10, var(--text-size-p3-mobile)) * 1px);
    --font-size-p2-desktop:calc(max(10, var(--text-size-p2-desktop)) * 1px);
    --font-size-p2-tablet:calc(max(10, var(--text-size-p2-tablet)) * 1px);
    --font-size-p2-mobile:calc(max(10, var(--text-size-p2-mobile)) * 1px);
    --font-size-p1-desktop:calc(max(10, var(--text-size-p1-desktop)) * 1px);
    --font-size-p1-tablet:calc(max(10, var(--text-size-p1-tablet)) * 1px);
    --font-size-p1-mobile:calc(max(10, var(--text-size-p1-mobile)) * 1px);
    --font-size-caption-desktop:calc(max(10, var(--text-size-caption-desktop)) * 1px);
    --font-size-caption-tablet:calc(max(10, var(--text-size-caption-tablet)) * 1px);
    --font-size-caption-mobile:calc(max(10, var(--text-size-caption-mobile)) * 1px);
    --font-size-button-desktop:calc(max(10, var(--text-size-button-desktop)) * 1px);
    --font-size-button-tablet:calc(max(10, var(--text-size-button-tablet)) * 1px);
    --font-size-button-mobile:calc(max(10, var(--text-size-button-mobile)) * 1px);
    --font-size-menu-desktop:calc(max(10, var(--text-size-menu-desktop)) * 1px);
    --font-size-menu-tablet:calc(max(10, var(--text-size-menu-tablet)) * 1px);
    --font-size-menu-mobile:calc(max(10, var(--text-size-menu-mobile)) * 1px);
    --font-size-product-name-desktop:calc(max(10, var(--text-size-product-name-desktop)) * 1px);
    --font-size-product-name-tablet:calc(max(10, var(--text-size-product-name-tablet)) * 1px);
    --font-size-product-name-mobile:calc(max(10, var(--text-size-product-name-mobile)) * 1px);
    --font-size-product-price-desktop:calc(max(10, var(--text-size-product-price-desktop)) * 1px);
    --font-size-product-price-tablet:calc(max(10, var(--text-size-product-price-tablet)) * 1px);
    --font-size-product-price-mobile:calc(max(10, var(--text-size-product-price-mobile)) * 1px);
    --font-size-product-price-compare-desktop:calc(max(10, var(--text-size-product-price-compare-desktop)) * 1px);
    --font-size-product-price-compare-tablet:calc(max(10, var(--text-size-product-price-compare-tablet)) * 1px);
    --font-size-product-price-compare-mobile:calc(max(10, var(--text-size-product-price-compare-mobile)) * 1px);
    --font-size-product-vendor-desktop:calc(max(10, var(--text-size-product-vendor-desktop)) * 1px);
    --font-size-product-vendor-tablet:calc(max(10, var(--text-size-product-vendor-tablet)) * 1px);
    --font-size-product-vendor-mobile:calc(max(10, var(--text-size-product-vendor-mobile)) * 1px);
    --font-size-caption-down-desktop:calc(max(10, var(--text-size-caption-desktop) - 2) * 1px);
    --font-size-caption-down-tablet:calc(max(10, var(--text-size-caption-tablet) - 2) * 1px);
    --font-size-caption-down-mobile:calc(max(10, var(--text-size-caption-mobile) - 2) * 1px);
    --heading-highlight-size-rate: {{ settings.heading_highlight_size_rate }}%;
    --body-letter-spacing: {{ settings.text_letter_spacing | times: 0.01 }}em;
    --heading-letter-spacing: {{ settings.heading_letter_spacing | times: 0.01 }}em;
    --heading-highlight-letter-spacing: {{ settings.heading_highlight_letter_spacing | times: 0.01 }}em;
    --menu-letter-spacing: {{ settings.menu_letter_spacing | times: 0.01 }}em;
    --button-letter-spacing: {{ settings.button_letter_spacing | times: 0.01 }}em;
    --border-radius: {{ border_radius }};
    --edges-radius: {{ edges_radius }};
    --page-width: {{ settings.page_width }}px;
    --width-countdown: calc(var(--font-size-p1) * 9);
    --font-menu: {{ settings.type_menu_font.family }}, {{ settings.type_menu_font.fallback_families }};
    --font-menu-weight: {{ settings.type_menu_font.weight }};
    --font-menu-style: {{ settings.type_menu_font.style }};
    --font-button: {{ settings.type_button_font.family }}, {{ settings.type_button_font.fallback_families }};
    --font-button-weight: {{ settings.type_button_font.weight }};
    --font-button-style: {{ settings.type_button_font.style }};
    --font-body-family: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
    --font-body-style: {{ settings.type_body_font.style }};
    --font-body-weight: {{ settings.type_body_font.weight }};
    --font-heading-family: {{ settings.type_header_font.family }}, {{ settings.type_header_font.fallback_families }};
    --font-heading-highlight: {{ settings.heading_highlight_font.family }}, {{ settings.heading_highlight_font.fallback_families }};
    --font-heading-highlight-style: {{ settings.heading_highlight_font.style }};
    --font-heading-highlight-weight: {{ settings.heading_highlight_font.weight }};
    --font-heading-style: {{ settings.type_header_font.style }};
    --font-heading-weight: {{ settings.type_header_font.weight }};
    --heading-text-tranform: {{ settings.heading_text_tranform }};
    --menu-text-tranform: {{ settings.menu_text_tranform }};
    --button-text-tranform: {{ settings.button_text_tranform }};
    --advanced-sections-spacing: {{ settings.advanced_sections_spacing }}px;
    --divider-spacing: -{{ settings.advanced_sections_spacing }};

    --color-heading: {{ scheme.settings.heading_color }};
    --color-text: {{ scheme.settings.text_color }};
    --color-background: {{ scheme.settings.background_color }};
    --color-background-secondary: {{ scheme.settings.secondary_background_color }};
    --color-border: {{ scheme.settings.line_and_border_color }};
    --color-highlight: {{ scheme.settings.highlight_color }};

    --color-primary-button: {{ scheme.settings.primary_button_color }};
    --color-primary-button-text: {{ scheme.settings.primary_button_text_color }};
    --color-primary-button-hover: {{ scheme.settings.primary_button_hover_color }};
    --color-primary-button-hover-text: {{ scheme.settings.primary_button_hover_text_color }};

    --color-secondary-button: {{ scheme.settings.secondary_button_color }};
    --color-secondary-button-text: {{ scheme.settings.secondary_button_text_color }};
    --color-link: {{ scheme.settings.text_link_color }};

    {% if settings.buttons_animation == 'fill_up' %}
      --button-width: 120%;
      --button-height: 100%;
      --button-transform: rotate3d(0,0,1,10deg) translate3d(-1.2em,110%,0);
      --button-transform-origin: 0% 100%;
    {% endif %}
  }
  .dark,
  .dark *:before {
    --color-heading: {{ scheme_dark.settings.heading_color }};
    --color-text: {{ scheme_dark.settings.text_color }};
    --color-background: {{ scheme_dark.settings.background_color }};
    --color-background-secondary: {{ scheme_dark.settings.secondary_background_color }};
    --color-border: {{ scheme_dark.settings.line_and_border_color }};
    --color-highlight: {{ scheme_dark.settings.highlight_color }};

    --color-primary-button: {{ scheme_dark.settings.primary_button_color }};
    --color-primary-button-text: {{ scheme_dark.settings.primary_button_text_color }};
    --color-primary-button-hover: {{ scheme_dark.settings.primary_button_hover_color }};
    --color-primary-button-hover-text: {{ scheme_dark.settings.primary_button_hover_text_color }};

    --color-secondary-button: {{ scheme_dark.settings.secondary_button_color }};
    --color-secondary-button-text: {{ scheme_dark.settings.secondary_button_text_color }};
    --color-link: {{ scheme_dark.settings.text_link_color }};
  }
  body.scrollbar-body::-webkit-scrollbar{
    width: {{ settings.scrollbar_width }};
  }
  .scrollbar-body::-webkit-scrollbar{
    width: 3px;
  }
  .scrollbar-body::-webkit-scrollbar-track{
    background: var(--color-border);
    opacity: 0.2;
  }
  .scrollbar-body::-webkit-scrollbar-thumb{
    background: var(--color-text);
    border-radius: 10px;
  }
  .section-padding {
    padding-top: {{ settings.section_padding_top_mobile }}px;
    padding-bottom: {{ settings.section_padding_bottom_mobile }}px;
  }
  @media (min-width: 1024px) {
    .section-padding {
      padding-top: {{ settings.section_padding_top }}px;
      padding-bottom: {{ settings.section_padding_bottom }}px;
    }
  }
  .padding-scrollbar, .padding-scrollbar-header {
    padding-right: {{ settings.scrollbar_width }};
  }
  {% if settings.buttons_color_mobile == "hover" %}
    [type="button"],
    .button {
      color: var(--color-primary-button-hover-text);
    }
    button.button-solid,
    .button.button-solid {
      border: none;
      background-color: rgba(var(--color-primary-button-hover));
    }
    button.button-disable-effect,
    .button.button-disable-effect {
      color: var(--color-primary-button-hover-text);
      background-color: var(--color-primary-button-hover);
    }
    .button-action {
      border: none;
      color: var(--color-primary-button-hover-text);
      background-color: var(--color-primary-button-hover);
    }
  {% else %}
    [type="button"],
    .button {
      color: var(--color-primary-button-text);
    }
    button.button-solid,
    .button.button-solid {
      border: none;
      background-color: var(--color-primary-button);
    }
    button.button-disable-effect,
    .button.button-disable-effect {
      color: var(--color-primary-button-text);
      background-color: var(--color-primary-button);
    }
    .button-action {
      border: none;
      color: var(--color-primary-button-text);
      background-color: var(--color-primary-button);
    }
  {% endif %}
  {% if settings.buttons_animation == 'sliced' %}
    .button.button-outline:not(.not-icon),
    .button.button-solid:not(.not-icon) {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding-left: 1rem;
      padding-right: 1rem;
    }
    .button-solid .button-icon,
    .button-solid .button-text {
      transition-timing-function: cubic-bezier(0,.71,.4,1);
    }
    .button-solid .button-icon {
      transition: opacity .25s,transform .5s;
    }
    .button-solid .button-text {
      transition: transform .5s;
      transform: translateX(10px);
    }
    button.button-solid.disable-action-btn-animation:disabled:hover .button-text, .button.button-solid.disable-btn-animation:hover .button-text {
      transform: translateX(10px);
    }
    .button-solid:hover .button-text {
      opacity: 1;
      transform: translateX(0px);
    }
    .button-solid:hover .button-icon {
      opacity: 1;
      transform: translateX(5px);
    }
  {% endif %}
  {% if settings.buttons_animation == 'underline' %}
    .button-solid .button-text {
      position: relative;
      display: block;
    }
    .button-solid .button-text::after {
      content: "";
      pointer-events: none;
      bottom: 1px;
      left: 50%;
      position: absolute;
      width: 0%;
      height: 1px;
      background-color: var(--color-primary-button-text);
      transition-timing-function: cubic-bezier(0.25, 0.8, 0.25, 1);
      transition-duration: 400ms;
      transition-property: width, left;
    }
    .button-solid:hover .button-text::after {
      {% if settings.buttons_color_mobile == "hover" %}
        background-color: var(--color-primary-button-hover-text);
      {% else %}
        background-color: var(--color-primary-button-text);
      {% endif %}
      width: 100%;
      left: 0%;
    }
  {% endif %}
  {% if settings.buttons_animation == 'fill_up' %}
    button.button-solid:before,
    .button.button-solid:before {
      content: "";
      z-index: -1;
      position: absolute;
      top: 0;
      right: 0;
      bottom: 0;
      left: 0;
      width: var(--button-width);
      height: var(--button-height);
      background-color: var(--colors-button-hover);
      backface-visibility: hidden;
      will-change: transform;
      transform: var(--button-transform);
      transform-origin: var(--button-transform-origin);
      transition: transform 0.5s ease;
    }
    button.button-solid:hover:before,
    .button.button-solid:hover:before {
      transform: rotate3d(0,0,1,0) translateZ(0);
    }
  {% endif %}
  {% if settings.buttons_animation == 'underline' %}
    .button-solid:hover .button-text::after {
      background-color: var(--color-primary-button-hover-text);
    }
  {% endif %}
{% endstyle %}