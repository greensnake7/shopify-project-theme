
{%- liquid
  assign ratio = 100
  case settings.product_image_ratio
    when "portrait"
      assign ratio = 150
    when "landscape"
      assign ratio = 75
    when "wide"
      assign ratio = 56.25
    when "3/4"
      assign ratio = 133
  endcase

  assign results_size = popular_product_search.products_count
-%}

<div class="background-header search-page:bg-[rgba(var(--background-color))] shadow-[0_0_6px_-4px_rgba(var(--colors-text))] pt-6 pb-7">
  <div id="suggest-search" class="overflow-auto max-h-[60vh] mobile-dock:max-h-[40vh] search-page:max-h-[45vh] scrollbar-body">
    <div class="search-suggest-container content-{{ settings.search_style }}" x-data="{ currentTab:{% if search_recomendation.links == blank and popular_product_search.products_count > 0 %} 2{% else %} 1{% endif %}, select(index){ this.currentTab = index } }">

      {% if search_recomendation.links != blank and results_size > 0 %}
        <div class="md:hidden pl-6 pr-6 lg:pl-10 lg:pr-10 md:h-auto relative mb-6">
          <div class="relative top-0 left-0 z-20 w-full overflow-hidden md:overflow-visible flex md:block">
            <div class="search-title h3 text-left lg:mb-2 md:w-auto pr-6 md:inline-block cursor-pointer lg:ml-0 md:pr-4">
              <button
                class="md:line-clamp-none pb-1 pt-2.5 p-break-words hover-text-link leading-snug uppercase inline-block md:leading-none md:pt-1 md:pb-0.5 transition duration-200 text-suggest-search"
                :class="currentTab === 1 && 'border-solid border-b-2 border-current'"
                @click.prevent="select(1);"
              >
                Suggestions
              </button>
            </div>

            <div class="search-title h3 text-left lg:mb-2 md:w-auto md:inline-block cursor-pointer lg:ml-2.5 md:pr-0">
              <button
                class="md:line-clamp-none pb-1 pt-2.5 p-break-words hover-text-link leading-snug uppercase inline-block md:leading-none md:pt-1 md:pb-0.5 transition duration-200 md:pl-6 md:border-l text-suggest-search"
                :class="currentTab === 2 && 'border-solid border-b-2 border-current'"
                @click.prevent="select(2);"
              >
                Products
              </button>
            </div>
          </div>
        </div>
      {% endif %}

      {%- if search_recomendation.links != blank -%}
        <div class="popular-recomendation{%- if results_size > 0 -%}{% if settings.search_style == 'horizontal' %} lg:w-1/3{% else %}{% endif %}{% endif %}">
          <h2
            id="predictive-search-queries"
            class="predictive-search__heading hidden md:block pl-6 pr-6 lg:pl-10 lg:pr-10 pt-3 pb-5 uppercase text-suggest-search"
          >
            Suggestions
          </h2>

          <ul
            id="predictive-search-results-queries-list"
            class="predictive-search-list predictive-search-results-list gap-4 md:gap-5 pl-6 pr-6 lg:pl-10 lg:pr-10 pb-7 grid"
            role="group"
            aria-labelledby="predictive-search-queries"
            :class="currentTab == 1 ? 'block' : '!hidden md:block'"
          >
            {%- for link in search_recomendation.links -%}
              <li
                id="predictive-search-option-query-{{ forloop.index }}"
                class="predictive-search__list-item"
                role="option"
                aria-selected="false"
              >
                <a href="{{ link.url }}" class="predictive-search-item nav-link relative hover-text-link">
                  {{ link.title }}
                </a>
              </li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}

      {%- if results_size > 0 -%}
        {%- if search_recomendation.links != blank -%}
          <div class="line-spacing flex-shrink-0 hidden md:block"></div>
        {%- endif -%}

        <div class="popular-product-search grow">
          <h2
            id="predictive-search-products"
            class="predictive-search__heading hidden md:block pl-6 pr-6 lg:pl-10 lg:pr-10{% if search_recomendation.links != blank and settings.search_style == 'vertical' %} pt-6 lg:pt-7{% else %} pt-3{% endif %} pb-5 uppercase body-text-base-size"
          >
            Products
          </h2>

          <ul
            role="listbox"
            aria-labelledby="predictive-search-products"
            class="predictive-search-list grid md:!grid grid-cols-1 gap-5 pl-6 pr-6 lg:pl-10 lg:pr-10 pb-2"
            :class="currentTab == 2 ? 'block' : '!hidden md:grid'"
          >
            {%- for product in popular_product_search.products limit: settings.product_limit -%}
              <li
                id="predictive-search-option-{{ forloop.index }}"
                role="option"
                aria-selected="false"
              >
                <a href="{{ product.url }}" class="flex gap-4 pt-3 pb-3 pl-3 pr-3 relative disable-effect h-full">
                  {%- if product != blank -%}
                    {%- assign card_view_context = standard_event_context | default: 'search' -%}
                    <s-view-event
                      data-view-on-intersect
                      view-event-trigger="manual"
                      view-event-payload='{{ product | standard_event_data: "view", context: card_view_context | escape }}'
                    ></s-view-event>
                  {%- endif -%}

                  <div class="w-24 relative">
                    <div
                      class="relative overflow-hidden w-full float-left before:h-0 before:block{% unless settings.product_image_ratio == "natural" %} before:pb-[{{ ratio }}%]{% else %}{% if product.featured_media.media_type == "model" %} pb-[100%]{% endif %}{% endunless %}{% if settings.edges_type == 'rounded_corners' %} rounded-md{% endif %}"
                      {% if settings.product_image_ratio == "natural" and product.featured_media and product.featured_media.media_type != "model" %}
                        style="padding-bottom: {{ 100.0 | divided_by: product.featured_media.aspect_ratio }}%;"
                      {% endif %}
                    >
                      {%- if product.featured_media != blank -%}
                        {% # theme-check-disable ImgLazyLoading %}
                        <img
                          src="{{ product.featured_media | image_url: width: 150 }}"
                          alt="{{ product.featured_media.alt | split: "#" | first | escape }}"
                          width="{{ product.featured_media.width }}"
                          {% if settings.enable_lazy_loading_image %}loading="lazy"{% else %}loading="eager"{% endif %}
                          onload="requestAnimationFrame(() => { this.closest('.skeleton-image')?.classList.remove('animate-Xpulse', 'skeleton-image'); });"
                          height="{{ product.featured_media.height }}"
                          class="h-full w-full object-cover absolute top-0 left-0 image-hover z-30 animate-Xpulse skeleton-image"
                        >
                        {% # theme-check-enable ImgLazyLoading %}
                      {%- else -%}
                        <div class="bg-[#c9c9c9]{% unless settings.product_image_ratio == "natural" %} absolute{% endunless %} top-0 left-0 w-full h-full">
                          {%- render 'icon-placeholder', icon: 'icon-product', class: 'w-full h-full' %}
                        </div>
                      {%- endif -%}
                    </div>
                  </div>

                  <div class="flex-1">
                    {%- if settings.predictive_search_show_vendor -%}
                      <div class="leading-tight mb-2 uppercase p-break-words tracking-widest text-xs">
                        {{ product.vendor }}
                      </div>
                    {%- endif -%}

                    <div class="mb-2 font-medium">
                      <p class="p-break-words leading-tight duration-200 transition hover-text-link text-[rgba(var(--colors-heading))]">
                        {{ product.title | escape }}
                      </p>
                    </div>

                    {%- if settings.predictive_search_show_price -%}
                      {% render 'price', product: product, use_variant: true, show_badges: false, mini_card: true %}
                    {%- endif -%}
                  </div>
                </a>
              </li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}

    </div>
  </div>
</div>