{% liquid
  assign search_type = 'query,'
  if settings.show_products
    assign search_type = search_type | append: 'product,'
  endif
  if settings.show_collections
    assign search_type = search_type | append: 'collection,'
  endif
  if settings.show_pages
    assign search_type = search_type | append: 'page,'
  endif
  if settings.show_articles
    assign search_type = search_type | append: 'article,'
  endif
  assign search_type = search_type | remove_last: ','
%}

<div
  x-data="xModalSearch('{{ search_type }}','{{ settings.search_desktop_maximun_results }}',{{ settings.search_mobile_maximun_results }}, 'All types')"
  class="x-container-header-search justify-center items-center max-w-7xl header-search lg:flex lg:mr-0.5
    {%- if settings.mobile_search_position == 'navigation' or settings.search_enabled == false or section.settings.search_on_header == false and enable_compact_menu == false %} hidden{% else %} pt-4 md:pt-0{% endif -%}
    {%- unless settings.search_enabled and section.settings.search_on_header and enable_compact_menu == false %} pb-header{% endunless %}"
  @click.away="openResults = false;"
>
  {%- if settings.predictive_search_enabled -%}
    <div class="relative max-w-4xl w-full" data-loading-text="Loading...">
  {%- endif -%}
  <div class="max-w-248 mr-auto ml-auto w-full border border-solid rounded-(--edges-radius)">
    <div class="relative field flex">
      {% if settings.search_refined %}
        <div class="md:relative search-categories flex items-center w-1/4">
          <div
            class="flex shrink min-w-0 w-full border-r pl-2 pr-2"
            x-data="{
              open: false
            }"
            @keyup.escape="open = false"
          >
            <button
              @click.prevent="open = ! open;"
              class="relative flex items-center justify-between shrink min-w-0 gap-2 w-full pt-1 pb-1 pl-1 pr-1 text-left cursor-pointer hover-text-link duration-200 transition bg-(--color-background-secondary) {% if settings.edges_type == 'rounded_corners' %}rounded-md{% endif %}"
              :aria-expanded="open"
              aria-controls="CategoriesList"
            >
              <span class="line-clamp-1 p-break-words" x-text="productTypeSelected"></span>
              <span class="opacity-60 relative w-2.5 h-2.5 flex" :class="open && ' -rotate-180'">
                {% render 'icon-alls', icon: 'icon-caret' %}
              </span>
            </button>

            <div
              x-cloak
              x-show="open"
              @click.away="open = false"
            >
              <div
                x-show="open"
                x-transition:enter="transition-all ease-in-out duration-500"
                x-transition:enter-start="opacity-0 transform -translate-y-4"
                x-transition:enter-end="opacity-100 transform translate-y-0"
                x-transition:leave="transition-all ease-in-out duration-500"
                x-transition:leave-end="opacity-0 transform translate-y-4"
                class="absolute z-60 pt-6 pb-7 left-0 top-[calc(100%+12px)] lg:bottom-auto background-header shadow-[0_0_6px_-4px_rgba(var(--colors-text))]"
              >
                <ul
                  role="list"
                  id="CategoriesList"
                  class="w-full md:w-auto md:min-w-60 pl-7 pr-7 left-0 max-h-60 overflow-y-auto scrollbar-body scrollbar-visible"
                >
                  <li
                    tabindex="0"
                    role="button"
                    class="cursor-pointer pt-1 pb-1 duration-200 transition text-[rgb(var(--colors-text-header))]"
                    @click="setProductType('All types', 'product_type'); open = false"
                    @keydown.enter.prevent="$el.click()"
                    @keydown.space.prevent="$el.click()"
                  >
                    <p
                      class="nav-link inline-block hover-text-link relative p-break-words"
                      :class="productTypeSelected == 'All types' && 'border-b link-active'"
                      data-no-instant
                    >
                      All types
                    </p>
                  </li>

                  {% for product_type in shop.types %}
                    {% if product_type != blank %}
                      <li
                        tabindex="0"
                        role="button"
                        class="product-type-item cursor-pointer pt-1 pb-1 duration-200 transition text-[rgb(var(--colors-text-header))]"
                        @click="setProductType(`{{ product_type }}`, 'product_type'); open = false"
                        @keydown.enter.prevent="$el.click()"
                        @keydown.space.prevent="$el.click()"
                      >
                        <p
                          class="nav-link inline-block hover-text-link relative p-break-words"
                          :class="productTypeSelected == `{{ product_type }}` && 'border-b effect-inline'"
                          data-no-instant
                        >
                          {{ product_type }}
                        </p>
                      </li>
                    {% endif %}
                  {%- endfor -%}
                </ul>
              </div>
            </div>

            <input
              type="hidden"
              aria-hidden="true"
              name="product_type"
              id="product_type"
              value="product_type:"
              data-disclosure-input
              tabindex="-1"
            />
          </div>
        </div>
      {% endif %}

      <form
        id="header-form-search-{{ section.id }}"
        class="{% if settings.search_refined %}w-3/4{% else %}w-full{% endif %}"
        action="{{ routes.search_url }}"
        method="get"
        role="search"
      >
        {% style %}
          .input-search::placeholder {
            {% if settings.search_prompts_font == "search_prompts_font_text" %}
              font-family: var(--font-body-family);
            {% else %}
              font-family: var(--font-heading-family);
            {% endif %}
          }
        {% endstyle %}
        <input
          id="header-search-in-modal"
          class="peer input-search focus-visible:outline-none{% if settings.search_refined %} pt-3 pb-3{% else %} pt-4 pb-4{% endif %} pl-4 pr-18 lg:pl-2 lg:pr-11 text-left w-full appearance-none relative outline-none bg-transparent placeholder:text-current placeholder:opacity-60 rounded-(--edges-radius)"
          type="search"
          name="q"
          value=""
          x-on:keyup="keyUp()"
          @keydown.tab="openResults = false;"
          @focus="focusForm()"
          placeholder="Search..."
        >
        <input type="hidden" aria-hidden="true" name="type" value="{{ settings.search_type | remove: ',collection' }}">
        <input type="hidden" aria-hidden="true" name="options[prefix]" value="none">
        <button class="btn-search absolute none_border w-7 h-7 pt-1 pb-1 pl-1 pr-1 top-1/2 -translate-y-1/2 opacity-60 bg-none text-current lg:right-2{% if settings.search_refined %} right-2{% else %} right-7{% endif %}">
          {%- render 'icon-alls', icon: 'icon-search', animation_class: 'icon-animation' -%}
        </button>
        {%- if settings.predictive_search_enabled -%}
          {% style %}
            #header-search-result {
              width: calc(var(--page-width));
              max-width: calc(100vw - 45px);
            }
          {% endstyle %}
          <div
            x-cloak
            x-intersect.once="$store.xHelper.centerElement($el)"
            :class="openResults ? 'visible' : 'invisible'"
            id="header-search-result"
            class="md:max-h-96 z-50 w-full absolute left-0"
            tabindex="-1"
            data-predictive-search
            x-html="result"
            x-show="loading == false"
            style="top: calc(100% + 12px)"
          >
            <div class="predictive-search__loading-state">
              <svg aria-hidden="true" focusable="false" role="presentation" class="spinner" viewBox="0 0 66 66" xmlns="http://www.w3.org/2000/svg">
                <circle class="path" fill="none" stroke-width="6" cx="33" cy="33" r="30"></circle>
              </svg>
            </div>
          </div>
        {%- endif -%}
      </form>
    </div>
  </div>
  {%- if settings.predictive_search_enabled -%}
    </div>
  {%- endif -%}
</div>