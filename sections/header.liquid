{% style %}
  {% if section.settings.sticky_header == "always" %}
    .section-header {
      position: sticky;
      z-index: 10;
      top: 0;
    }
    #x-header-container.is-scrolled {
      box-shadow: 0 5px 15px color-mix(in srgb, var(--color-text) 10%, transparent);
    }
  {% endif %}
  {% if section.settings.sticky_header == "scroll-up" %}
    .section-header:has(#x-header-container.is-sticky) {
      position: sticky;
      z-index: 10;
      top: 0;
    }
    #x-header-container.is-sticky:not(.scroll-up-animation) {
      box-shadow: 0 5px 15px color-mix(in srgb, var(--color-text) 10%, transparent);
    }
    #x-header-container.is-animation {
      transform: translateY(0);
      transition: transform 0.4s ease-in-out 0.1s;
      will-change: transform;
    }
    #x-header-container.scroll-up-animation {
      transform: translateY(var(--header-sticky-transform));
    }
    .section-header:has(#x-header-container.scroll-up-animation) {
      pointer-events: none
    }
  {% endif %}
{% endstyle %}
{% liquid
  assign logo_position = section.settings.logo_position
  assign search_on_header = section.settings.search_on_header
  assign enable_hamburger_menu = section.settings.enable_hamburger_menu
%}
<div 
  id="x-header-container"
  class="bg-(--color-background) is-animation"
  x-init='() => {
    $store.xHeader.sectionId = "{{ section.id }}";
    $store.xHeader.initSticky($el, "{{ section.settings.sticky_header }}");
    document.addEventListener("shopify:section:load", function(event) {
      $store.xHeader.reset();
    })
  }'
>
  <div class="page-width py-5 flex items-center flex-col {% if logo_position == 'center' %}md:flex-col justify-center{% else %}md:flex-row justify-between{% endif %} md:gap-y-3 gap-y-1">
    <div class="{% if logo_position == 'center' and search_on_header or enable_hamburger_menu == false %}md:block{% endif %} hidden">
      {% render 'shop-logo', 
        logo: section.settings.logo, 
        aspect_ratio: section.settings.logo_ratio, 
        logo_desktop_width: section.settings.logo_desktop_width, 
        logo_mobile_width: section.settings.logo_mobile_width
      %}
    </div>
    <header class="grow grid md:grid-cols-[1fr_2fr_1fr] {% if logo_position == 'left' %}grid-cols-[2fr_1fr_2fr]{% else %}grid-cols-[1fr_2fr_1fr]{% endif %} justify-between items-center w-full gap-x-6">
      <div class="header_left flex items-center gap-x-2">
        <div class="{% if logo_position == 'center' %}hidden{% endif %}">
          {% render 'shop-logo', 
            logo: section.settings.logo, 
            aspect_ratio: section.settings.logo_ratio, 
            logo_desktop_width: section.settings.logo_desktop_width, 
            logo_mobile_width: section.settings.logo_mobile_width
          %}
        </div>
        <div class="w-11 h-11 pl-3 pr-3 pt-3 pb-3 {% if logo_position == 'left' %}hidden{% else %}block{% endif %} {% if enable_hamburger_menu %}md:block{% else %}md:hidden{% endif %}">
          {% render 'icon-alls', icon: 'icon-hamburger', animation_class: 'icon-animation' %}
        </div>
      </div>
      <div class="header_center flex flex-col justify-center items-center gap-y-1 md:gap-y-3">
        <div class="{% if logo_position == 'center' %}{% if search_on_header or enable_hamburger_menu == false %}md:hidden{% else %}md:flex justify-center{% endif %}{% else %}hidden{% endif %}">
          {% render 'shop-logo', 
            logo: section.settings.logo, 
            aspect_ratio: section.settings.logo_ratio, 
            logo_desktop_width: section.settings.logo_desktop_width, 
            logo_mobile_width: section.settings.logo_mobile_width
          %}
        </div>
        <div class="rounded-(--edges-radius) z-30 {% unless search_on_header %}p-2 fixed bg-(--color-background) left-1/2 -translate-x-1/2 w-[calc(100%-2rem)] max-w-240 animation-x-expand{% else %}w-full hidden md:block{% endunless %}"
          {% unless search_on_header %}
            x-cloak
            x-show="$store.xHeader.showSearchBar"
            @click.away="$store.xHeader.showSearchBar = false;
              document.getElementById('x-header-container').classList.add('is-animation');
              $store.xOverlay.close();
            "
          {% endunless %}
        >
          {% render 'header-search-item', search_on_header: search_on_header %}
        </div>
        {% unless enable_hamburger_menu %}
          <div class="menu header_menu gap-x-10 pt-3 hidden md:flex justify-center">
            {% for link in section.settings.menu.links %}
              {{ link.title | link_to: link.url }}
            {% endfor %}
          </div>
        {% endunless %}
      </div>
      <div class="header_right flex {% if search_on_header and enable_hamburger_menu == false %}self-start{% else %}self-center{% endif %} justify-self-end">
        {% unless search_on_header %}
          <div class="w-11 h-11 pl-3 pr-3 pt-3 pb-3" 
            @click="$store.xHeader.showSearchBar = true;
              document.getElementById('x-header-container').classList.remove('is-animation');
              $store.xOverlay.open();
            "
          >
            {% render 'icon-alls', icon: 'icon-search', animation_class: 'icon-animation' %}
          </div>
        {% endunless %}
        {%- if shop.customer_accounts_enabled -%}
          <shopify-account class="header-icon-account hidden md:block relative items-center justify-center" menu="{{ settings.customer_account_menu }}">
            <div slot="signed-out-avatar">
              <span class="w-11 h-11 pl-3 pr-3 pt-3 pb-3 block">
                {% render 'icon-alls', icon: 'icon-account', animation_class: 'icon-animation' %}
              </span>
            </div>
          </shopify-account>
        {%- endif -%}
        <a href="{{ routes.cart_url }}" class="w-11 h-11 pl-3 pr-3 pt-3 pb-3 block">
          {% if cart.item_count > 0 %}
            <sup>{{ cart.item_count }}</sup>
          {% endif %}
          {% render 'icon-alls', icon: 'icon-cart', animation_class: 'icon-animation' %}
        </a>
        <div class="w-11 h-11 pl-3 pr-3 pt-3 pb-3 {% if logo_position == 'left' %}block{% else %}hidden{% endif %} md:hidden">
          {% render 'icon-alls', icon: 'icon-hamburger', animation_class: 'icon-animation' %}
        </div>
        {%- if settings.theme_mode_enabled -%}
          {%- if settings.theme_mode_mode == 'switch' -%}
            <theme-mode x-data class="hidden md:block">
              <button
                @click.prevent="$store.xDarkMode.toggleThemeMode()"
                class="text-sm w-11 h-11 pl-3 pr-3 pt-3 pb-3 block"
              >
                <span x-cloak class="block" x-show="$store.xDOM.rePainting === $store.xDarkMode.alias">
                  {% render 'icon-alls', icon: 'icon-loading' %}
                </span>
                <span x-cloak class="hidden dark:block" x-show="$store.xDOM.rePainting !== $store.xDarkMode.alias">
                  <svg class="icon-animation" xmlns="http://www.w3.org/2000/svg" width="100%" height="100%" viewBox="0 0 24 24" fill="none">
                    <path d="M12 2C6.47715 2 2 6.47715 2 12C2 17.5229 6.47715 22 12 22C17.5229 22 22 17.5229 22 12C22 6.47715 17.5229 2 12 2ZM12 20.75C7.1675 20.75 3.25 16.8325 3.25 12C3.25 7.1675 7.1675 3.25 12 3.25C16.8325 3.25 20.75 7.1675 20.75 12C20.75 16.8325 16.8325 20.75 12 20.75Z" fill="currentColor"/>
                    <path d="M12 5.125C11.6548 5.125 11.375 5.4048 11.375 5.75V18.25C11.375 18.5952 11.6548 18.875 12 18.875C15.797 18.875 18.875 15.797 18.875 12C18.875 8.20305 15.797 5.125 12 5.125Z" fill="currentColor"/>
                  </svg>
                </span>
                <span x-cloak class="block dark:hidden" x-show="$store.xDOM.rePainting !== $store.xDarkMode.alias">
                  <svg class="icon-animation" xmlns="http://www.w3.org/2000/svg" width="100%" height="100%" viewBox="0 0 24 24" fill="none">
                    <path d="M12 2C6.47715 2 2 6.47715 2 12C2 17.5229 6.47715 22 12 22C17.5229 22 22 17.5229 22 12C22 6.47715 17.5229 2 12 2ZM12 20.75C7.1675 20.75 3.25 16.8325 3.25 12C3.25 7.1675 7.1675 3.25 12 3.25C16.8325 3.25 20.75 7.1675 20.75 12C20.75 16.8325 16.8325 20.75 12 20.75Z" fill="currentColor"/>
                    <path d="M12.25 5.125C12.5952 5.125 12.875 5.4048 12.875 5.75V18.25C12.875 18.5952 12.5952 18.875 12.25 18.875C8.45305 18.875 5.375 15.797 5.375 12C5.375 8.20305 8.45305 5.125 12.25 5.125Z" fill="currentColor"/>
                  </svg>
                </span>
              </button>
            </theme-mode>
          {%- endif -%}
        {%- endif -%}
      </div>
    </header>
    {% if search_on_header %}
      <div class="rounded-(--edges-radius) z-30 {% unless search_on_header %}p-2 fixed bg-(--color-background) left-1/2 -translate-x-1/2 w-[calc(100%-2rem)] max-w-240 animation-x-expand{% else %}w-full{% endunless %} block md:hidden"
        {% unless search_on_header %}
          x-cloak
          x-show="$store.xHeader.showSearchBar"
          @click.away="$store.xHeader.showSearchBar = false;
            document.getElementById('x-header-container').classList.add('is-animation');
            $store.xOverlay.close();
          "
        {% endunless %}
      >
        {% render 'header-search-item', search_on_header: search_on_header %}
      </div>
    {% endif %}
  </div>
  <div x-cloak x-show="$store.xHeader.showSearchBar" class="fixed top-0 bottom-0 left-0 right-0 cursor-pointer z-20 transition-opacity duration-500 bg-[#c9c9c9]/30 backdrop-blur-xs"></div>
</div>
{% schema %}
{
  "name": "t:general.header",
  "class": "section-header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "default": "main-menu",
      "label": "t:labels.menu"
    },
    {
      "type": "checkbox",
      "id": "enable_hamburger_menu",
      "default": false,
      "label": "Enable hamburger menu"
    },
    {
      "type": "checkbox",
      "id": "search_on_header",
      "label": "Show search bar",
      "default": false
    },
    {
      "type": "select",
      "id": "logo_position",
      "label": "Logo position",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "dropdown_menu_trigger",
      "label": "Dropdown menu trigger",
      "options": [
        {
          "value": "hover",
          "label": "Hover"
        },
        {
          "value": "click",
          "label": "Click"
        }
      ],
      "default": "hover"
    },
    {
      "type": "select",
      "id": "sticky_header",
      "label": "Sticky header",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "scroll-up",
          "label": "On scroll up"
        },
        {
          "value": "always",
          "label": "Always"
        }
      ]
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "select",
      "id": "logo_ratio",
      "options": [
        {
          "value": "3/4",
          "label": "Standard (3:4)"
        },
        {
          "value": "square",
          "label": "Square (1:1)"
        },
        {
          "value": "2/3",
          "label": "Portrait (2:3)"
        },
        {
          "value": "4/3",
          "label": "Landscape (4:3)"
        },
        {
          "value": "16/9",
          "label": "Wide (16:9)"
        }
      ],
      "default": "3/4",
      "label": "Logo ratio"
    },
    {
      "type": "range",
      "id": "logo_desktop_width",
      "label": "Logo desktop width",
      "min": 50,
      "max": 300,
      "step": 10,
      "default": 120,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "logo_mobile_width",
      "label": "Logo mobile width",
      "min": 40,
      "max": 150,
      "step": 10,
      "default": 100,
      "unit": "px"
    }
  ]
}
{% endschema %}
