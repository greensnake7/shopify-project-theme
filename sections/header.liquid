{% style %}
  header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  header a {
    position: relative;
    text-decoration: none;
    color: var(--color-foreground);
  }
  header a sup {
    position: absolute;
    left: 100%;
    overflow: hidden;
    max-width: var(--page-margin);
  }
  header .header__menu {
    display: flex;
    gap: 1rem;
  }
{% endstyle %}
{% liquid
%}
<header class="page-width">
  <h2 class="header__title">
    {{ shop.name | link_to: routes.root_url }}
  </h2>

  <div class="header__menu">
    {% for link in section.settings.menu.links %}
      {{ link.title | link_to: link.url }}
    {% endfor %}
  </div>
  {% if section.settings.search_on_header %}
    {% render 'header-search-item' %}
  {% endif %}
  <div class="header__icons flex">
    <div class="w-11 h-11 pl-3 pr-3 pt-3 pb-3 {% if section.settings.search_on_header %}block md:hidden{% endif %}">
      {% render 'icon-alls', icon: 'icon-search', animation_class: 'icon-animation' %}
    </div>
    {%- if shop.customer_accounts_enabled -%}
      <shopify-account class="header-icon-account flex relative items-center justify-center" menu="{{ settings.customer_account_menu }}">
        <div slot="signed-out-avatar">
          <span class="w-11 h-11 pl-3 pr-3 pt-3 pb-3 block">
            {% render 'icon-alls', icon: 'icon-account', animation_class: 'icon-animation' %}
          </span>
        </div>
      </shopify-account>
    {%- endif -%}
    <a href="{{ routes.cart_url }}" class="w-11 h-11 pl-3 pr-3 pt-3 pb-3 block">
      {% if cart.item_count > 0 %}
        <sup>{{ cart.item_count }}</sup>
      {% endif %}
      {% render 'icon-alls', icon: 'icon-cart', animation_class: 'icon-animation' %}
    </a>
    {%- if settings.theme_mode_enabled -%}
      {%- if settings.theme_mode_mode == 'switch' -%}
        <theme-mode x-data>
          <button
            @click.prevent="$store.xDarkMode.toggleThemeMode()"
            class="text-sm w-11 h-11 pl-3 pr-3 pt-3 pb-3 block"
          >
            <span x-cloak class="block" x-show="$store.xDOM.rePainting === $store.xDarkMode.alias">
              {% render 'icon-alls', icon: 'icon-loading' %}
            </span>
            <span x-cloak class="hidden dark:block" x-show="$store.xDOM.rePainting !== $store.xDarkMode.alias">
              <svg class="icon-animation" xmlns="http://www.w3.org/2000/svg" width="100%" height="100%" viewBox="0 0 24 24" fill="none">
                <path d="M12 2C6.47715 2 2 6.47715 2 12C2 17.5229 6.47715 22 12 22C17.5229 22 22 17.5229 22 12C22 6.47715 17.5229 2 12 2ZM12 20.75C7.1675 20.75 3.25 16.8325 3.25 12C3.25 7.1675 7.1675 3.25 12 3.25C16.8325 3.25 20.75 7.1675 20.75 12C20.75 16.8325 16.8325 20.75 12 20.75Z" fill="currentColor"/>
                <path d="M12 5.125C11.6548 5.125 11.375 5.4048 11.375 5.75V18.25C11.375 18.5952 11.6548 18.875 12 18.875C15.797 18.875 18.875 15.797 18.875 12C18.875 8.20305 15.797 5.125 12 5.125Z" fill="currentColor"/>
              </svg>
            </span>
            <span x-cloak class="block dark:hidden" x-show="$store.xDOM.rePainting !== $store.xDarkMode.alias">
              <svg class="icon-animation" xmlns="http://www.w3.org/2000/svg" width="100%" height="100%" viewBox="0 0 24 24" fill="none">
                <path d="M12 2C6.47715 2 2 6.47715 2 12C2 17.5229 6.47715 22 12 22C17.5229 22 22 17.5229 22 12C22 6.47715 17.5229 2 12 2ZM12 20.75C7.1675 20.75 3.25 16.8325 3.25 12C3.25 7.1675 7.1675 3.25 12 3.25C16.8325 3.25 20.75 7.1675 20.75 12C20.75 16.8325 16.8325 20.75 12 20.75Z" fill="currentColor"/>
                <path d="M12.25 5.125C12.5952 5.125 12.875 5.4048 12.875 5.75V18.25C12.875 18.5952 12.5952 18.875 12.25 18.875C8.45305 18.875 5.375 15.797 5.375 12C5.375 8.20305 8.45305 5.125 12.25 5.125Z" fill="currentColor"/>
              </svg>
            </span>
          </button>
        </theme-mode>
      {%- endif -%}
    {%- endif -%}
    <div class="w-11 h-11 pl-3 pr-3 pt-3 pb-3 block">
      {% render 'icon-alls', icon: 'icon-hamburger', animation_class: 'icon-hamburger' %}
    </div>
  </div>
</header>
{% schema %}
{
  "name": "t:general.header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "default": "main-menu",
      "label": "t:labels.menu"
    },
    {
      "type": "checkbox",
      "id": "enable_hamburger_menu",
      "default": false,
      "label": "Enable hamburger menu"
    },
    {
      "type": "checkbox",
      "id": "search_on_header",
      "label": "Show search bar",
      "default": false
    },
    {
      "type": "select",
      "id": "logo_position",
      "label": "Logo position",
      "options": [
        {
          "value": "logo_on_side",
          "label": "Logo on side"
        },
        {
          "value": "logo_on_top",
          "label": "Logo on top"
        }
      ],
      "default": "logo_on_top"
    },
    {
      "type": "select",
      "id": "dropdown_menu_trigger",
      "label": "Dropdown menu trigger",
      "options": [
        {
          "value": "hover",
          "label": "Hover"
        },
        {
          "value": "click",
          "label": "Click"
        }
      ],
      "default": "hover"
    },
    {
      "type": "select",
      "id": "sticky_header",
      "label": "Sticky header",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "scroll_up",
          "label": "On scroll up"
        },
        {
          "value": "always",
          "label": "Always"
        }
      ]
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "range",
      "id": "logo_desktop_width",
      "label": "Logo desktop width",
      "min": 50,
      "max": 200,
      "step": 10,
      "default": 100,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "logo_mobile_width",
      "label": "Logo mobile width",
      "min": 40,
      "max": 150,
      "step": 10,
      "default": 60,
      "unit": "px"
    }
  ]
}
{% endschema %}
