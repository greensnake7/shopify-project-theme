{%- if predictive_search.performed -%}
  {% liquid 
    assign resources_collections = predictive_search.resources.collections
    assign results_size = predictive_search.resources.products.size | plus: resources_collections.size | plus: predictive_search.resources.pages.size | plus: predictive_search.resources.articles.size
  %}
  {% style %}
    #predictive-search-results {
      --si-img-ratio :
      {% case settings.image_ratio_search %}
        {% when 'portrait' %}2 / 3
        {% when 'landscape' %}4 / 3
        {% when 'wide' %}16 / 9
        {% when 'standard' %}3 / 4
        {% else %}1 / 1
      {% endcase %};
    }
  {% endstyle %}
  <div class="predictive-search bg-(--color-background) search-page:bg-(--color-background) pt-6 pb-6 rounded-(--edges-radius) overflow-hidden">
    <div id="predictive-search-results" class="overflow-auto max-h-[60vh] search-page:max-h-[45vh] scrollbar-body scroll-smooth"> 
      <div {% if results_size > 0 %}class="{% if settings.search_style == 'vertical' %}flex flex-col{% else %}grid md:grid-cols-2{% endif %}"{% endif %}>
        {%- if predictive_search.resources.queries.size > 0 or predictive_search.resources.pages.size > 0 -%}
          <div class="predictive-search-results-list search-result-query-and-page flex flex-row pb-6">
            {%- if predictive_search.resources.queries.size > 0 -%}
              <div class="query-and-page-content flex-1 flex flex-col pl-3 pr-3 lg:pl-6 lg:pr-6 {% if results_size > 0 and predictive_search.resources.pages.size > 0 %}border-r{% endif %}">
                <h5 id="predictive-search-queries" class="predictive-search-heading pb-5 px-3">Suggestions</h5>
                <ul id="predictive-search-results-queries-list" class="predictive-result-item predictive-search-results-list flex flex-wrap gap-5" role="group" aria-labelledby="predictive-search-queries">
                  {%- for query in predictive_search.resources.queries -%}
                    <li id="predictive-search-option-query-{{ forloop.index }}" class="predictive-search__list-item" role="option" aria-selected="false">
                      <a href="{{ query.url }}" class="search_heading predictive-search-item effect-inline hover-text-link relative px-2.5 py-1.5 duration-200 transition">
                        {{ query.styled_text | strip_html }}
                      </a>
                    </li>
                  {%- endfor -%}
                </ul>
              </div>
            {%- endif -%}
            {%- if results_size > 0 and predictive_search.resources.pages.size > 0 -%}
              <div class="query-and-page-content flex-1 flex flex-col pl-3 pr-3 lg:pl-6 lg:pr-6">
                <h5 id="predictive-search-pages" class="predictive-search-heading pb-5 px-3">Pages</h5>
                <div class="predictive-result-item gap-5 flex flex-wrap">
                  {%- for page in predictive_search.resources.pages -%} 
                    <div class="inline-block rounded-(--edges-radius)">
                      <a href="{{ page.url }}" class="search_heading predictive-search-item effect-inline relative hover-text-link px-2.5 py-1.5 duration-200 transition">
                        {{ page.title | escape }}
                      </a>
                    </div>
                  {%- endfor -%}
                </div>
              </div>
            {%- endif -%} 
          </div>
        {%- endif -%}
        {%- if results_size > 0 -%}
          {%- if predictive_search.resources.products.size > 0 -%}
            {% liquid
              assign enable_desktop_slider = false
              assign swiper_on_mobile = false
              if settings.search_style == 'vertical'
                if predictive_search.resources.products.size > 2
                  assign swiper_on_mobile = true
                endif
                if predictive_search.resources.products.size > 4
                  assign enable_desktop_slider = true
                endif
              endif
            %}
            <div class="pl-3 pr-3 lg:pl-6 lg:pr-6 pb-6">
              <h5 id="predictive-search-products" class="predictive-search-heading pb-5 px-3">Products</h5>
              <div id="predictive-search-products-{{ section.id }}" class="splide visible overflow-hidden" x-show="openResults"
                {% if enable_desktop_slider or swiper_on_mobile %}
                  x-intersect.once.margin.200px='$store.xSplide.load($el, {
                    "speed": 1000,
                    "mediaQuery": "min",
                    "updateOnMove": "true",
                    "drag": true,
                    "focus": "right",
                    "pagination": false,
                    "breakpoints": {
                      300: {
                        "gap": "16px",
                        "padding": 0,
                        "fixedWidth": "40%",
                        "perPage": 2,
                        "perMove": 1
                      },
                      768: {
                        {% unless enable_desktop_slider %}
                          "destroy": true,
                        {% endunless %}
                        "gap": "20px",
                        "padding": 0,
                        "fixedWidth": false,
                        "perPage": 4,
                        "perMove": 1,
                        "arrows": true
                      }
                    },
                    "classes": {
                      "arrows" : "splide__arrows block"
                    }
                  })'
                {% endif %}
              >
                <div class="splide__arrows hidden md:block order-2">
                  <button type="button" class="splide__arrow splide__arrow--prev button-arrow pt-3 pb-3 pr-3 pl-3 rounded-full z-10 w-11 h-11 border border-solid disabled:cursor-not-allowed disabled:opacity-30 hidden md:block md:absolute md:top-1/2 md:-mt-6 md:left-0 md:duration-200 hover:opacity-100 md:transition-all md:ease-in-out md:-translate-x-full">
                    <span class="hidden">Previous slide</span>
                    {% render 'icon-alls', icon: 'chevron-right' %}
                  </button>
                  <button type="button" class="splide__arrow splide__arrow--next button-arrow pt-3 pb-3 pr-3 pl-3 rounded-full z-10 w-11 h-11 border border-solid disabled:cursor-not-allowed disabled:opacity-30 hidden md:block md:absolute md:top-1/2 md:-mt-6 md:right-0 md:duration-200 hover:opacity-100 md:transition-all md:ease-in-out md:translate-x-full">
                    <span class="hidden">Next slide</span>
                    {% render 'icon-alls', icon: 'chevron-right' %}
                  </button>
                </div>
                <div class="splide__track">
                  <div class="splide__list predictive-result-item {% if settings.search_style == 'vertical' %}{% unless enable_desktop_slider %}md:grid md:grid-cols-4 gap-5{% endunless %} {% unless swiper_on_mobile %}grid grid-cols-2 gap-4{% endunless %}{% else %}flex flex-col gap-2{% endif %}">
                    {%- for product in predictive_search.resources.products -%} 
                      <div id="predictive-search-option-{{ forloop.index }}" class="splide__slide" aria-selected="false">
                        <a href="{{ product.url }}" class="flex gap-4 relative disable-effect h-full {% if settings.search_style == 'vertical' %}flex-col{% else %}flex-row{% endif %}">
                          <div class="w-full relative">
                            <div class="relative overflow-hidden w-full float-left rounded-(--edges-radius) aspect-(--si-img-ratio)">
                              {%- if product.featured_media != blank -%}
                                {% # theme-check-disable ImgLazyLoading %}
                                <img
                                  src="{{ product.featured_media | image_url: width: 150 }}"
                                  alt="{{ product.featured_media.alt | split: "#" | first | escape }}"
                                  width="{{ product.featured_media.width }}"
                                  {% if settings.enable_lazy_loading_image %}loading="lazy"{% else %}loading="eager"{% endif %}
                                  onload="requestAnimationFrame(() => { this.closest('.skeleton-image')?.classList.remove('animate-Xpulse', 'skeleton-image'); });"
                                  height="{{ product.featured_media.height }}"
                                  class="w-full aspect-(--si-img-ratio) object-cover image-hover z-0 animate-Xpulse skeleton-image"
                                >
                                {% # theme-check-enable ImgLazyLoading %}
                              {%- else -%}
                                <div class="bg-[#c9c9c9]{% unless settings.product_image_ratio == "natural" %} absolute{% endunless %} top-0 left-0 w-full h-full">{%- render 'icon-placeholder', icon: 'icon-product', class: 'w-full h-full' %}</div>
                              {%- endif -%}
                            </div>
                          </div>
                          <div class="flex-1 {% if settings.search_style == 'vertical' %}px-2 md:px-4{% endif %}">
                            {%- if settings.show_vendor -%} 
                              <div class="x-card-vendor x-heading leading-tight mb-2  p-break-words tracking-widest">{{ product.vendor }}</div>
                            {%- endif -%}
                            <div class="mb-2">
                              <p class="x-card-title p-break-words leading-tight duration-200 transition hover-text-link text-(--color-heading)">{{ product.title | escape }}</p> 
                            </div>
                            {%- if settings.show_price -%}
                              {% render 'price', product: product, use_variant: true, show_badges: false, mini_card: true %} 
                            {%- endif -%}
                          </div>
                        </a>
                      </div>
                    {%- endfor -%}
                  </div>
                </div>
              </div>
            </div>
          {%- endif -%}
          {%- if resources_collections.size > 0 -%} 
            <div class="pl-3 pr-3 lg:pl-6 lg:pr-6 pb-6">
              <h5 id="predictive-search-collections" class="predictive-search-heading pb-5 px-3">Collections</h5>
              <div class="predictive-result-item flex-1 pb-2.5 pl-3 pr-3 lg:pl-6 lg:pr-6 gap-2">
                {%- for collection in resources_collections -%} 
                  <div class="block pt-2 pb-2">
                    <a href="{{ collection.url }}" class="flex relative disable-effect h-full">
                      <div class="w-24 relative">
                        <div class="relative overflow-hidden w-full float-left rounded-(--edges-radius) aspect-(--si-img-ratio)">
                          {%- if collection.featured_image != blank -%}
                            {% # theme-check-disable ImgLazyLoading %}
                            <img
                              src="{{ collection.featured_image | image_url: width: 300 }}"
                              alt="{{ collection.featured_image.alt | escape }}"
                              width="{{ collection.featured_image.width }}"
                              {% if settings.enable_lazy_loading_image %}loading="lazy"{% else %}loading="eager"{% endif %}
                              onload="requestAnimationFrame(() => { this.closest('.skeleton-image')?.classList.remove('animate-Xpulse', 'skeleton-image'); });"
                              height="{{ collection.featured_image.height }}"
                              class="h-full w-full object-cover absolute top-0 left-0 z-0 image-hover animate-Xpulse skeleton-image"
                            >
                            {% # theme-check-enable ImgLazyLoading %}
                          {%- else -%}
                            <div class="bg-[#c9c9c9] absolute top-0 left-0 w-full h-full">{%- render 'icon-placeholder', icon: 'icon-collection', class: 'w-full h-full' %}</div>
                          {%- endif -%}
                        </div>
                      </div>
                        <div class="pt-2 ml-5 flex-1">
                        <p class="search_heading hover-text-link disable-effect p-break-words leading-tight duration-200 transition hover-text-link text-(--colors-heading)">{{ collection.title | escape }}</p> 
                      </div>
                    </a>
                  </div>
                {%- endfor -%}
              </div>
            </div>
          {%- endif -%}
          {%- if predictive_search.resources.articles.size > 0 -%} 
            <div class="pl-3 pr-3 lg:pl-6 lg:pr-6 pb-6">
              <h5 id="predictive-search-articles" class="predictive-search-heading pb-5 px-3">Articles</h5>
              <div class="predictive-result-item pb-2.5 pl-3 pr-3 lg:pl-6 lg:pr-6 gap-2">
                {%- for article in predictive_search.resources.articles -%} 
                  <div class="block pt-2 pb-2">
                    <a href="{{ article.url }}" class="flex relative disable-effect h-full">
                      <div class="w-24 relative">
                        <div class="relative overflow-hidden w-full float-left rounded-(--edges-radius) aspect-(--si-img-ratio)">
                          {%- if article.image != blank -%}
                            {% # theme-check-disable ImgLazyLoading %}
                            <img
                              src="{{ article.image.src | image_url: width: 300 }}"
                              alt="{{ article.image.alt | escape }}"
                              width="{{ article.image.width }}"
                              {% if settings.enable_lazy_loading_image %}loading="lazy"{% else %}loading="eager"{% endif %}
                              onload="requestAnimationFrame(() => { this.closest('.skeleton-image')?.classList.remove('animate-Xpulse', 'skeleton-image'); });"
                              height="{{ article.image.height }}"
                              class="h-full w-full object-cover absolute top-0 left-0 image-hover z-0 animate-Xpulse skeleton-image"
                            >
                            {% # theme-check-enable ImgLazyLoading %}
                          {%- else -%}
                            <div class="bg-[#c9c9c9] absolute top-0 left-0 w-full h-full">{%- render 'icon-placeholder', icon: 'icon-image', class: 'w-full h-full' %}</div>
                          {%- endif -%}
                        </div>
                      </div>
                      <div class="pt-2 ml-5 flex-1">
                        <p class="search_heading line-clamp-2 hover-text-link disable-effect p-break-words leading-tight duration-200 transition hover-text-link text-(--colors-heading)">{{ article.title | escape }}</p> 
                      </div>
                    </a>
                  </div>
                {%- endfor -%}
              </div>
            </div>
          {%- endif -%}
        {%- else -%} 
          <div class="text-center pt-5 pb-5 pl-5 pr-5" data-predictive-search-live-region-count-value>
            No results found for "{{ predictive_search.terms }}"
          </div>
        {%- endif -%}
      </div>
    </div>
    {% if settings.search_show_view_more and results_size > 0 %}
      <button type="submit" class="background-header pt-6 pl-6 pr-6 border-solid rounded-none inline-block cursor-pointer hover-text-link text-center w-full text-current border-t">
        View all results
      </button>
    {%- endif -%}
  </div>
{%- endif -%} 
