        "options": [
          {
            "value": "none",
            "label": "t:settings_schema.design.carousel.desktop_pagination_style.option_1"
          },
          {
            "value": "line",
            "label": "t:settings_schema.design.carousel.desktop_pagination_style.option_2"
          },
          {
            "value": "dots",
            "label": "t:settings_schema.design.carousel.desktop_pagination_style.option_3"
          },
          {
            "value": "arrows",
            "label": "t:settings_schema.design.carousel.mobile_pagination_style.option_1"
          }
        ],
        "default": "none"
