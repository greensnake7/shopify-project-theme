[
  {
    "name": "theme_info",
    "theme_name": "Skeleton",
    "theme_version": "0.1.0",
    "theme_author": "Shopify",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://support.shopify.com/"
  },
  {
    "name": "Theme mode",
    "settings": [
      {
        "type": "checkbox",
        "id": "theme_mode_enabled",
        "default": true,
        "label": "Enable theme mode"
      },
      {
        "type": "select",
        "id": "theme_mode_mode",
        "options": [
          {
            "value": "auto",
            "label": "Use device settings"
          },
          {
            "value": "switch",
            "label": "Allow manual switch"
          }
        ],
        "default": "switch",
        "label": "Select mode",
        "visible_if": "{{ settings.theme_mode_enabled }}"
      },
      {
        "type": "select",
        "id": "theme_mode_default",
        "options": [
          {
            "value": "light",
            "label": "Light"
          },
          {
            "value": "dark",
            "label": "Dark"
          }
        ],
        "default": "light",
        "label": "Default mode",
        "visible_if": "{{ settings.theme_mode_enabled }}"
      }
    ]
  },
  {
    "name": "Schemes",
    "settings": [
      {
        "type": "color_scheme_group",
        "id": "scheme_group",
        "definition": [
          {
            "type": "header",
            "content": "General"
          },
          {
            "type": "color",
            "id": "heading_color",
            "label": "Heading",
            "default": "#1B1B1B"
          },
          {
            "type": "color",
            "id": "text_color",
            "label": "Text",
            "default": "#323232"
          },
          {
            "type": "color",
            "id": "line_and_border_color",
            "label": "Line and border",
            "default": "#DFDDD5"
          },
          {
            "type": "color",
            "id": "highlight_color",
            "label": "Highlight",
            "default": "#B8581D"
          },
          {
            "type": "header",
            "content": "Background"
          },
          {
            "type": "color",
            "id": "background_color",
            "label": "Background",
            "default": "#FFFFFF"
          },
          {
            "type": "color",
            "id": "secondary_background_color",
            "label": "Secondary background",
            "default": "#FCFAF6"
          },
          {
            "type": "header",
            "content": "Button and text link"
          },
          {
            "type": "color",
            "id": "primary_button_color",
            "label": "Primary button",
            "default": "#202020"
          },
          {
            "type": "color",
            "id": "primary_button_text_color",
            "label": "Primary button text",
            "default": "#FFFFFF"
          },
          {
            "type": "color",
            "id": "primary_button_hover_color",
            "label": "Primary button hover",
            "default": "#B8581D"
          },
          {
            "type": "color",
            "id": "primary_button_hover_text_color",
            "label": "Primary button hover text",
            "default": "#FFFFFF"
          },
          {
            "type": "color",
            "id": "secondary_button_color",
            "label": "Secondary button",
            "default": "transparent"
          },
          {
            "type": "color",
            "id": "secondary_button_text_color",
            "label": "Secondary button text",
            "default": "#202020"
          },
          {
            "type": "color",
            "id": "text_link_color",
            "label": "Text link",
            "default": "#B8581D"
          }
        ],
        "role": {
          "text": "text_color",
          "background": {
            "solid": "background_color",
            "gradient": ""
          },
          "links": "text_link_color",
          "icons": "text_color",
          "primary_button": "primary_button_color",
          "on_primary_button": "primary_button_text_color",
          "primary_button_border": "primary_button_color",
          "secondary_button": "secondary_button_color",
          "on_secondary_button": "secondary_button_text_color",
          "secondary_button_border": "line_and_border_color"
        }
      }
    ]
  },
  {
    "name": "Color",
    "settings": [
      {
        "type": "color_scheme",
        "id": "color_scheme",
        "label": "Color scheme",
        "default": "scheme_1"
      },
      {
        "type": "color_scheme",
        "id": "color_scheme_dark",
        "label": "Color scheme (dark)",
        "default": "scheme_2"
      }
    ]
  },
