  {
    "name": "Theme mode",
    "settings": [
      {
        "type": "checkbox",
        "id": "theme_mode_enabled",
        "default": true,
        "label": "Enable theme mode"
      },
      {
        "type": "select",
        "id": "theme_mode_mode",
        "options": [
          {
            "value": "auto",
            "label": "Use device settings"
          },
          {
            "value": "switch",
            "label": "Allow manual switch"
          }
        ],
        "default": "switch",
        "label": "Select mode",
        "visible_if": "{{ settings.theme_mode_enabled }}"
      },
      {
        "type": "select",
        "id": "theme_mode_default",
        "options": [
          {
            "value": "light",
            "label": "Light"
          },
          {
            "value": "dark",
            "label": "Dark"
          }
        ],
        "default": "light",
        "label": "Default mode",
        "visible_if": "{{ settings.theme_mode_enabled }}"
      }
    ]
  },
  {
