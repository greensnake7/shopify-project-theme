  },
  {
    "name": "Search and navigation",
    "settings": [
      {
        "type": "header",
        "content": "Search"
      },
      {
        "type": "checkbox",
        "id": "search_enabled",
        "default": true,
        "label": "Enable search"
      },
      {
        "type": "select",
        "id": "mobile_search_position",
        "label": "Position on mobile",
        "options": [
          {
            "label": "Header",
            "value": "header"
          },
          {
            "label": "Mobile navigation",
            "value": "navigation"
          }
        ],
        "default": "header",
        "visible_if": "{{ settings.search_enabled }}"
      },
      {
        "type": "checkbox",
        "id": "search_refined",
        "default": false,
        "label": "Enable refined search box",
      },
      {
        "type": "select",
        "id": "search_style",
        "options": [
          {
            "value": "vertical",
            "label": "Vertical"
          },
          {
            "value": "horizontal",
            "label": "Horizontal"
          }
        ],
        "default": "vertical",
        "label": "Desktop layout"
      },
      {
        "type": "header",
        "content": "Search results"
      },
      {
        "type": "checkbox",
        "id": "predictive_search_enabled",
        "default": true,
        "label": "Enable product suggestions"
      },
      {
        "type": "checkbox",
        "id": "show_products",
        "default": true,
        "label": "Show products",
        "visible_if": "{{ settings.predictive_search_enabled }}"
      },
      {
        "type": "checkbox",
        "id": "show_collections",
        "default": true,
        "label": "Show collections",
        "visible_if": "{{ settings.predictive_search_enabled }}"
      },
      {
        "type": "checkbox",
        "id": "show_pages",
        "default": true,
        "label": "Show pages",
        "visible_if": "{{ settings.predictive_search_enabled }}"
      },
      {
        "type": "checkbox",
        "id": "show_articles",
        "default": true,
        "label": "Show articles",
        "visible_if": "{{ settings.predictive_search_enabled }}"
      },
      {
        "type": "select",
        "id": "image_ratio_search",
        "options": [
          {
            "value": "standard",
            "label": "Standard (3:4)"
          },
          {
            "value": "square",
            "label": "Square (1:1)"
          },
          {
            "value": "portrait",
            "label": "Portrait (2:3)"
          },
          {
            "value": "landscape",
            "label": "Landscape (4:3)"
          },
          {
            "value": "wide",
            "label": "Wide (16:9)"
          }
        ],
        "default": "standard",
        "label": "Image ratio"
      },
      {
        "type": "range",
        "id": "search_desktop_maximun_results",
        "min": 1,
        "max": 10,
        "step": 1,
        "label": "Desktop maximum results",
        "default": 10
      },
      {
        "type": "range",
        "id": "search_mobile_maximun_results",
        "min": 1,
        "max": 6,
        "step": 1,
        "label": "Mobile maximum results",
        "default": 6
      },
      {
        "type": "checkbox",
        "id": "search_show_view_more",
        "default": false,
        "label": "Show \"View more\" button"
      },
      {
        "type": "header",
        "content": "Product cards on search box"
      },
      {
        "type": "checkbox",
        "default": false,
        "id": "show_price",
        "label": "Show price"
      },
      {
        "type": "checkbox",
        "default": false,
        "id": "show_vendor",
        "label": "Show vendor"
      },
      {
        "type": "checkbox",
        "default": false,
        "id": "show_rating",
        "label": "Show rating"
      },
      {
        "type": "header",
        "content": "Default search message"
      },
      {
        "type": "text",
        "id": "default_search_message",
        "label": "Search bar default message",
        "default": "What are you looking for?"
      },
      {
        "type": "checkbox",
        "id": "enabled_mobile_message",
        "label": "Enable mobile search message",
        "default": false
      },
      {
        "type": "header",
        "content": "Breadcrumbs"
