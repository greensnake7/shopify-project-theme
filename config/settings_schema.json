      {
        "type": "checkbox",
        "id": "show_breadcrumbs",
        "default": true,
        "label": "Show breadcrumbs"
      },
      {
        "type": "select",
        "id": "breadcrumbs_separator",
        "options": [
          {
            "value": "›",
            "label": "›"
          },
          {
            "value": ">",
            "label": ">"
          },
          {
            "value": "•",
            "label": "•"
          },
          {
            "value": "·",
            "label": "·"
          },
          {
            "value": "/",
            "label": "/"
          },
          {
            "value": "-",
            "label": "-"
          },
          {
            "value": "—",
            "label": "—"
          },
          {
            "value": "~",
            "label": "~"
          }
        ],
        "default": "—",
        "label": "Breadcrumb separator",
        "visible_if": "{{ settings.show_breadcrumbs }}"
      }
