          {
            "value": "slide",
            "label": "Slide"
          },
          {
            "value": "fill_up",
            "label": "Fill up"
          },
          {
            "value": "sliced",
            "label": "Sliced with icon"
          },
          {
            "value": "underline",
            "label": "Underline"
