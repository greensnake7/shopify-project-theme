        "type": "header",
        "content": "General"
      },
      {
        "type": "select",
        "id": "edges_type",
        "options": [
          {
            "value": "square",
            "label": "Square"
          },
          {
            "value": "rounded_corners",
            "label": "Rounded corners"
          }
        ],
        "default": "square",
        "label": "t:settings_schema.design.edges"
      },
      {
        "type": "select",
        "id": "buttons_type",
        "options": [
          {
            "value": "square",
            "label": "Square"
          },
          {
            "value": "rounded",
            "label": "Rounded"
          },
          {
            "value": "rounded_corners",
            "label": "Rounded corners"
          }
