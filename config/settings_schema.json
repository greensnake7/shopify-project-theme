[
  {
    "name": "theme_info",
    "theme_name": "Skeleton",
    "theme_version": "0.1.0",
    "theme_author": "Shopify",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://support.shopify.com/"
  },
  {
    "name": "Schemes",
    "settings": [
      {
        "type": "header",
        "content": "Schemes"
      },
      {
        "type": "color_scheme_group",
        "id": "scheme_group",
        "definition": [
          {
            "type": "header",
            "content": "General"
          },
          {
            "type": "color",
            "id": "heading_color",
            "label": "Heading",
            "default": "#1B1B1B"
          },
          {
            "type": "color",
            "id": "text_color",
            "label": "Text",
            "default": "#323232"
          },
          {
            "type": "color",
            "id": "line_and_border_color",
            "label": "Line and border",
            "default": "#DFDDD5"
          },
          {
            "type": "color",
            "id": "highlight_color",
            "label": "Highlight",
            "default": "#B8581D"
          },
          {
            "type": "header",
            "content": "Background"
          },
          {
            "type": "color",
            "id": "background_color",
            "label": "Background",
            "default": "#FFFFFF"
          },
          {
            "type": "color",
            "id": "secondary_background_color",
            "label": "Secondary background",
            "default": "#FCFAF6"
          },
          {
            "type": "header",
            "content": "Button and text link"
          },
          {
            "type": "color",
            "id": "primary_button_color",
            "label": "Primary button",
            "default": "#202020"
          },
          {
            "type": "color",
            "id": "primary_button_text_color",
            "label": "Primary button text",
            "default": "#FFFFFF"
          },
          {
            "type": "color",
            "id": "primary_button_hover_color",
            "label": "Primary button hover",
            "default": "#B8581D"
          },
          {
            "type": "color",
            "id": "primary_button_hover_text_color",
            "label": "Primary button hover text",
            "default": "#FFFFFF"
          },
          {
            "type": "color",
            "id": "secondary_button_color",
            "label": "Secondary button",
            "default": "transparent"
          },
          {
            "type": "color",
            "id": "secondary_button_text_color",
            "label": "Secondary button text",
            "default": "#202020"
          },
          {
            "type": "color",
            "id": "text_link_color",
            "label": "Text link",
            "default": "#B8581D"
          }
        ],
        "role": {
          "text": "text_color",
          "background": {
            "solid": "background_color",
            "gradient": ""
          },
          "links": "text_link_color",
          "icons": "text_color",
          "primary_button": "primary_button_color",
          "on_primary_button": "primary_button_text_color",
          "primary_button_border": "primary_button_color",
          "secondary_button": "secondary_button_color",
          "on_secondary_button": "secondary_button_text_color",
          "secondary_button_border": "line_and_border_color"
        }
      }
    ]
  },
  {
    "name": "t:settings_schema.typography.name",
    "settings": [
      {
        "type": "header",
        "content": "t:settings_schema.typography.settings.header__2.content"
      },
      {
        "type": "font_picker",
        "id": "type_body_font",
        "default": "assistant_n4",
        "label": "t:settings_schema.typography.settings.type_header_font.label"
      },
      {
        "type": "range",
        "id": "text_base_size",
        "min": 50,
        "max": 200,
        "step": 10,
        "unit": "%",
        "label": "t:settings_schema.typography.base_size",
        "default": 100
      },
      {
        "type": "range",
        "id": "text_letter_spacing",
        "min": -20,
        "max": 80,
        "step": 1,
        "unit": "%",
        "label": "t:settings_schema.typography.letter_spacing",
        "default": 0
      },
      {
        "type": "header",
        "content": "t:settings_schema.typography.settings.header__1.content"
      },
      {
        "type": "font_picker",
        "id": "type_header_font",
        "default": "assistant_n4",
        "label": "t:settings_schema.typography.settings.type_header_font.label"
      },
      {
        "type": "range",
        "id": "heading_base_size",
        "min": 50,
        "max": 200,
        "step": 10,
        "unit": "%",
        "label": "t:settings_schema.typography.base_size",
        "default": 100
      },
      {
        "type": "range",
        "id": "heading_letter_spacing",
        "min": -20,
        "max": 80,
        "step": 1,
        "unit": "%",
        "label": "t:settings_schema.typography.letter_spacing",
        "default": 0
      },
      {
        "type": "select",
        "id": "heading_text_tranform",
        "options": [
          {
            "value": "none",
            "label": "t:sections.all.size.options__4.label"
          },
          {
            "value": "capitalize",
            "label": "t:settings_schema.typography.capitalize"
          },
          {
            "value": "uppercase",
            "label": "t:settings_schema.typography.uppercase"
          },
          {
            "value": "lowercase",
            "label": "t:settings_schema.typography.lowercase"
          }
        ],
        "default": "none",
        "label": "t:settings_schema.typography.text_tranform"
      },
      {
        "type": "font_picker",
        "id": "heading_highlight_font",
        "default": "assistant_n4",
        "label": "t:settings_schema.typography.heading_highlight_font"
      },
      {
        "type": "range",
        "id": "heading_highlight_base_size",
        "min": 30,
        "max": 200,
        "step": 5,
        "unit": "%",
        "label": "t:settings_schema.typography.heading_highlight_size",
        "default": 100
      },
      {
        "type": "range",
        "id": "heading_highlight_letter_spacing",
        "min": -20,
        "max": 80,
        "step": 1,
        "unit": "%",
        "label": "t:settings_schema.typography.letter_spacing",
        "default": 0
      },
      {
        "type": "header",
        "content": "Others"
      },
      {
        "type": "font_picker",
        "id": "type_menu_font",
        "default": "assistant_n4",
        "label": "t:settings_schema.typography.type_menu_font"
      },
      {
        "type": "range",
        "id": "menu_letter_spacing",
        "min": -20,
        "max": 80,
        "step": 1,
        "unit": "%",
        "label": "t:settings_schema.typography.letter_spacing",
        "default": 0
      },
      {
        "type": "select",
        "id": "menu_text_tranform",
        "options": [
          {
            "value": "none",
            "label": "t:sections.all.size.options__4.label"
          },
          {
            "value": "capitalize",
            "label": "t:settings_schema.typography.capitalize"
          },
          {
            "value": "uppercase",
            "label": "t:settings_schema.typography.uppercase"
          },
          {
            "value": "lowercase",
            "label": "t:settings_schema.typography.lowercase"
          }
        ],
        "default": "none",
        "label": "t:settings_schema.typography.text_tranform"
      },
      {
        "type": "font_picker",
        "id": "type_button_font",
        "default": "assistant_n4",
        "label": "t:settings_schema.typography.type_button_font"
      },
      {
        "type": "range",
        "id": "button_letter_spacing",
        "min": -20,
        "max": 80,
        "step": 1,
        "unit": "%",
        "label": "t:settings_schema.typography.letter_spacing",
        "default": 0
      },
      {
        "type": "select",
        "id": "button_text_tranform",
        "options": [
          {
            "value": "none",
            "label": "t:sections.all.size.options__4.label"
          },
          {
            "value": "capitalize",
            "label": "t:settings_schema.typography.capitalize"
          },
          {
            "value": "uppercase",
            "label": "t:settings_schema.typography.uppercase"
          },
          {
            "value": "lowercase",
            "label": "t:settings_schema.typography.lowercase"
          }
        ],
        "default": "none",
        "label": "t:settings_schema.typography.text_tranform"
      }
    ]
  },
  {
    "name": "t:general.layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "t:labels.page_width",
        "options": [
          {
            "value": "90rem",
            "label": "t:options.page_width.narrow"
          },
          {
            "value": "110rem",
            "label": "t:options.page_width.wide"
          }
        ],
        "default": "90rem"
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 10,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "t:labels.page_margin",
        "default": 20
      }
    ]
  }
